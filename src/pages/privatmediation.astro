---
import { getImage } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import ContactStrip from "../components/ContactStrip.astro";
import Illustration from "../components/Illustration.astro";
import privateConflict from "../assets/privatmediation-1.png";
import privateDialogue from "../assets/privatmediation-2.png";
import privateSolution from "../assets/privatmediation-3.png";

const privateImages = await Promise.all(
  [
    { src: privateConflict, alt: "KI-generierte Illustration einer Familie mit angespannten Beziehungen am gemeinsamen Tisch." },
    { src: privateDialogue, alt: "KI-generierte Illustration einer Familie, die miteinander spricht und ihre Sichtweisen austauscht." },
    { src: privateSolution, alt: "KI-generierte Illustration einer Familie, die gemeinsame Lösungen vereinbart und miteinander umsetzt." },
  ].map(async ({ src, alt }) => ({
    image: await getImage({ src, width: 1024, format: "webp", quality: 85 }),
    alt,
  })),
);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Privatmediation für Paare, Familien und andere private Konfliktsituationen – vertraulich, persönlich und mit Blick auf eine gemeinsame Lösung." />
    <title>Privatmediation | Kristin Goßen</title>
  </head>
  <body>
    <ContactStrip />
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="back-link" href="/#privatmediation">← Zur Startseite</a>
    </header>
    <main>
      <div class="private-introduction">
      <div class="private-content">
      <h1>Privatmediation</h1>
      <Illustration
        class="service-image"
        src="/privatmediation-gemeinsam-umsetzen.png"
        alt="KI-generierte Illustration einer Familie, die gemeinsam Lösungen für private Konflikte umsetzt."
        width={1536}
        height={1024}
        fetchpriority="high"
      />
      <div class="description">
        <h2>Wenn Beziehungen durch Konflikte belastet werden.</h2>
        <p>
          Für Paare, Familien, Nachbarn und andere private Konfliktsituationen –
          vertraulich, persönlich und mit Blick auf eine gemeinsame Lösung.
        </p>
      </div>
      </div>
      </div>
      <div class="private-followup">
      <div class="private-content">
      <div class="description followup-description">
        <div class="consultation-text">
          <p class="satisfaction-statement">Zufriedenheit ist nicht selbstverständlich<br />und oft schwer umsetzbar.</p>
        </div>
      </div>
      </div>
      </div>
      <div class="private-guidance">
      <div class="private-content">
      <div class="description followup-description">
        <div class="consultation-text">
          <p>
            Wir begleiten Sie in Gesprächen und führen Sie zu Ihren gemeinsamen Lösungen,
            für eine leichtere Zukunft.
          </p>
          <p>
            Bei unserem Erstgespräch nehmen wir uns genügend Zeit für Ihre Anliegen
            und danken Ihnen für Ihr Vertrauen.
          </p>
        </div>
        <a class="consultation" href="tel:+4915161235537">Unverbindliches Erstgespräch</a>
      </div>
      </div>
      </div>
      <div class="private-process">
      <div class="private-content">
      <div class="description followup-description">
        <section class="mediation-process" aria-labelledby="process-heading">
          <h2 id="process-heading">Wie läuft Mediation ab?</h2>
          <p class="process-principles">Nach den 5 Phasen der Mediation:</p>
          <ol class="mediation-phases">
            <li>
              1. Rahmenbedingungen, Ablauf und Regeln werden erläutert und die
              Schweigepflicht nach außen wird erklärt.
            </li>
            <li>
              2. Ansichten, Konflikte und Problematiken äußern. Der/die Mediator-in ist
              parteilos und neutral und gibt jedem genügend Raum, seine eigene
              Sichtweise darzustellen.
            </li>
            <li>
              3. Aufdecken der Hintergründe: Interessen, Motive, Gefühle,
              Bedürfnisse und Wünsche werden herausgearbeitet, um Ursachen von
              Konflikten zu erkennen und auch Missverständnisse auszuräumen.
            </li>
            <li>4. Lösungsvorschläge und Lösungsentwicklung</li>
            <li>5. Lösungsvereinbarung</li>
          </ol>
          <p>
            Auf Wunsch vereinbaren wir gerne einen weiteren Termin zur Erhaltung
            und Bewahrung der erarbeiteten Lösungen.
          </p>
        </section>
      </div>
      </div>
      </div>
      <div class="private-gallery-section">
      <div class="private-content">
      <div class="private-gallery" role="group" aria-label="Vom Konflikt über das Gespräch zur gemeinsamen Lösung">
        {privateImages.map(({ image, alt }) => (
          <Illustration
            src={image.src}
            alt={alt}
            width={Number(image.attributes.width)}
            height={Number(image.attributes.height)}
            loading="lazy"
          />
        ))}
      </div>
      </div>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("/fonts/CormorantGaramond.ttf") format("truetype");
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #16343d;
    font-family: "Times New Roman", Times, serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  header {
    background: #f7f6f2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 18px 6%;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }

  .brand {
    width: min(340px, 100%);
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.78) contrast(1.3) saturate(1.1);
  }

  .back-link {
    color: #168c91;
  }

  .private-content {
    max-width: 1328px;
    margin: 0 auto;
  }

  .private-introduction {
    display: flow-root;
    padding: 40px 24px 28px;
    background: #eee3d1;
  }

  .private-followup {
    padding: 32px 24px 1.6rem;
    background: #f7f6f2;
  }

  .private-guidance {
    padding: 1.6rem 24px 24px;
    background: #eee3d1;
  }

  .private-process {
    display: flow-root;
    padding: 0 24px;
    background: #f7f6f2;
  }

  .private-gallery-section {
    padding: 40px 24px 72px;
    background: #eee3d1;
  }

  h1 {
    margin: 0 0 30px;
    text-align: center;
    color: #168c91;
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: clamp(2rem, 3.2vw, 2.65rem);
    font-weight: 400;
    line-height: 1.5;
  }

  .service-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .private-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
    margin-top: 0;
  }

  .description {
    max-width: 760px;
    margin: 40px auto 0;
    text-align: center;
  }

  .followup-description {
    margin-top: 0;
  }

  .private-introduction .description > p:last-child {
    margin-bottom: 0;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
    font-weight: 500;
  }

  .consultation {
    display: inline-block;
    margin-top: 16px;
    padding: 14px 24px;
    border: 1px solid #e5b62f;
    border-radius: 999px;
    background: #e5b62f;
  }

  .private-guidance .consultation {
    margin-top: 52px;
  }

  .consultation-text {
    margin-top: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .consultation-text p {
    margin: 0;
  }

  .satisfaction-statement {
    color: #168c91;
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
  }

  .consultation-text p + p {
    margin-top: 1lh;
  }

  .consultation-text p + p:last-child {
    margin-top: 1lh;
  }

  .mediation-process {
    margin-top: 0;
  }

  #process-heading {
    margin-top: calc(0.83em + 1lh - 24px);
    color: #168c91;
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: clamp(2rem, 3.2vw, 2.65rem);
    font-weight: 400;
    line-height: 1.5;
  }

  .process-principles {
    margin: 24px 0 0;
  }

  .mediation-phases {
    color: #168c91;
    display: grid;
    gap: 1lh;
    margin: 1lh 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 800px) {
    .private-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
