---
import SiteFooter from "../components/SiteFooter.astro";
import ContactStrip from "../components/ContactStrip.astro";
import Illustration from "../components/Illustration.astro";
import ConfluenceStrip from "../components/ConfluenceStrip.astro";
import { Image } from "astro:assets";
import mountainsPhoto from "../assets/berge-see.jpeg";
const navItems = [
  { label: "Privatmediation", href: "/privatmediation/" },
  { label: "Wirtschaftsmediation", href: "/wirtschaftsmediation/" },
  { label: "Blog", href: "/blog/" },
  { label: "Kontakt", href: "/kontakt/" },
];
const portraitOutline = "M100 2 C120 44 156 80 198 100 C156 120 120 156 100 198 C80 156 44 120 2 100 C44 80 80 44 100 2 Z";
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Professionelle Mediation für Privatpersonen und Unternehmen – vertraulich, neutral und lösungsorientiert."
    />
    <title>MEDIATION Kristin Gossen | Faire Konfliktlösung</title>
  </head>
   <body>
    <ContactStrip />
    <header class="site-header">
      <a class="brand" href="/">
      <img class="brand-logo" src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="header-portrait" href="/kristin-gossen/" aria-label="Über Kristin Goßen">
        <svg class="portrait-frame" viewBox="0 0 200 200" role="img" aria-label="Kristin Goßen">
          <defs>
            <clipPath id="portrait-clip" clipPathUnits="userSpaceOnUse">
              <path d={portraitOutline} />
            </clipPath>
          </defs>
          <image href="/Foto Medi.jpeg" width="200" height="200" preserveAspectRatio="xMidYMin slice" clip-path="url(#portrait-clip)" />
          <path d={portraitOutline} fill="none" stroke="#168c91" stroke-width="2.5" stroke-linejoin="miter" />
        </svg>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="main-navigation"
        aria-expanded="false"
        aria-label="Menü öffnen"
      >
        <span class="menu-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
      <ConfluenceStrip>
        <nav id="main-navigation" class="main-nav" aria-label="Hauptnavigation">
          {
            navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a class="about-header" href="/kristin-gossen/">Über mich</a>
        </nav>
      </ConfluenceStrip>
    </header>
    <main>
      <section class="hero">
        <div class="hero-introduction">
        <div class="hero-content">
          <p class="hero-intro">Faire Konfliktlösung ist für jeden, der bereit ist,<br />Stress zu bewältigen und<br />seine Lebensqualität zu steigern.</p>
          <Image
            class="hero-photo"
            src={mountainsPhoto}
            alt="See vor einer Berglandschaft bei Sonnenuntergang."
            width={1920}
            widths={[480, 960, 1920]}
            sizes="(max-width: 1142px) 84vw, 960px"
            format="webp"
            loading="eager"
            decoding="async"
          />
          <p class="eyebrow hero-principles">
            <span>VERTRAULICH</span>
            <span>EIGENVERANTWORTLICH</span>
            <span>UNPARTEIISCH</span>
            <span>AUSSERGERICHTLICH</span>
          </p>

          <p class="satisfaction-statement">Zufriedenheit ist ein Verdienst.</p>
        </div>
        </div>
        <div class="hero-mediation">
        <div class="hero-content">
          <div class="mediation-layout">
            <div class="mediation-columns">
            <div class="mediation-benefits">
              <strong class="mediation-emphasis">Mediation</strong>
              <ul class="mediation-list">
                <li>ist freiwillig</li>
                <li>verschwiegen</li>
                <li>bringt Verständigung</li>
                <li>macht handlungsfähig</li>
                <li>ist neutral und selbstbestimmt</li>
                <li>verschafft Klarheit und neue Sichtweisen</li>
              </ul>
            </div>
            <div class="mediation-info">
              <section class="mediation-faq" aria-label="Häufige Fragen zur Mediation">
                <details id="kosten-privatmediation">
                  <summary>Wie viel kostet eine Privatmediation?</summary>
                  <div class="faq-answer">
                    <p>
                      Ab 2 Personen:<br />
                      1. und 2. Stunde: € 95,00<br />
                      Ab der 3. Stunde: € 75,00<br />
                      Doppelstunden kosten € 150,00.
                    </p>
                    <p>
                      Ein Stundenpaket ab 5 Stunden kann bei aufwendiger Problematik
                      von Vorteil sein und individuell mit Ihnen geplant werden.
                    </p>
                    <p>Die Preise verstehen sich inkl. Mwst.</p>
                  </div>
                </details>
                <details id="kosten-wirtschaftsmediation">
                  <summary>Wie viel kostet eine Wirtschaftsmediation?</summary>
                  <div class="faq-answer">
                    <p>
                      60 Minuten kosten durchschnittlich € 250,00.<br />
                      Doppelstunden kosten € 390,00.<br />
                      Workshops von 6 Stunden kosten € 800,00.
                    </p>
                    <p>Ausschlaggebend ist vor allem die Teamgröße.</p>
                    <p>
                      Bei mehr als 3 involvierten Teilnehmern ist eine Doppelstunde
                      empfehlenswert.
                    </p>
                    <p>Die Preise verstehen sich zzgl. Mwst.</p>
                  </div>
                </details>
                <details id="gesetzliche-grundlage">
                  <summary>Gibt es eine gesetzliche Grundlage?</summary>
                  <div class="faq-answer">
                    <p>
                      Ja. Die gesetzliche Grundlage für Mediation in Deutschland
                      ist das Mediationsgesetz (MediationsG).
                    </p>
                    <p>
                      <a class="law-source-link" href="https://www.gesetze-im-internet.de/mediationsg/BJNR157710012.html">
                        Bundesministerium der Justiz und Verbraucherschutz
                      </a>
                    </p>
                  </div>
                </details>
              </section>
              <p class="hero-text">
                Gemeinsam arbeiten wir an einer Win-Win-Lösung. Realistisch,
                zukunftsorientiert und <span class="hero-text-highlight">selbstbestimmend, ohne gerichtliche Urteile</span>.
                Alltagstaugliche Vereinbarungen und nachhaltige Lösungen, um private
                oder auch geschäftliche Beziehungen zu schützen.
              </p>
            </div>
            </div>
            <p class="mediation-closing">
              <strong class="mediation-emphasis">fragt nicht nach einem Schuldigen</strong>
            </p>
          </div>
        </div>
        </div>

      </section>
       <section class="services">
        <div class="section-intro">
          <p class="eyebrow">Ein gemeinsames Ziel</p>
          <h2>Konflikte dort lösen,<br /> <span class="conflict-location">wo sie entstehen.</span></h2>
        </div>

        <div class="service-grid">
          <article class="service-card" id="privatmediation">
            <p class="service-label">Privatmediation</p>
            <a href="/privatmediation/" aria-label="Privatmediation öffnen">
              <Illustration
                class="service-image"
                src="/privatmediation-gemeinsam-umsetzen.png"
                alt="KI-generierte Illustration einer Familie, die gemeinsam Lösungen für private Konflikte umsetzt."
                width={1536}
                height={1024}
                loading="lazy"
              />
            </a>
            <h3>Wenn Beziehungen durch Konflikte belastet werden.</h3>
            <p>
              Für Paare, Familien, Nachbarn und andere private Konfliktsituationen –
              vertraulich, persönlich und mit Blick auf eine gemeinsame Lösung.
            </p>
            <a href="/privatmediation/">Mehr erfahren →</a>
          </article>

          <article class="service-card" id="wirtschaftsmediation">
            <p class="service-label">Wirtschaftsmediation</p>
            <a href="/wirtschaftsmediation/" aria-label="Wirtschaftsmediation öffnen">
            <Illustration
              class="service-image"
              src="/motiviertes-team.png"
              alt="KI-generierte Illustration eines motivierten Teams, das in einem hellen Büro zusammenarbeitet."
              width={1536}
              height={1024}
              loading="lazy"
            />
            </a>
            <h3>Wenn Zusammenarbeit wieder möglich werden soll.</h3>
            <p>
              Für Konflikte zwischen Mitarbeitenden, Teams oder Führungskräften –
              professionell, strukturiert und auf Wunsch dokumentiert.
            </p>
            <a href="/wirtschaftsmediation/">Mehr erfahren →</a>
          </article>
        </div>
        <div class="conflict-consultation">
          <h1>
            <span class="hero-title">Nicht entscheiden, wer Recht hat.</span><br />
            <span class="hero-resolution">Sondern verstehen, was es braucht.</span>
          </h1>
        </div>
      </section>
       <section class="approach">
        <div class="approach-grid">
          <div class="approach-image-slot">
            <img
              class="approach-image"
              src="/zwei-menschen.jpeg"
              alt="Zwei Menschen gehen gemeinsam durch eine Straße im Sonnenuntergang."
              width="4284"
              height="5712"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="approach-text">
            <div class="approach-heading">
              <p class="eyebrow">Wofür Mediation?</p>
              <h2>
                Menschen<br />
                Wahrnehmungen<br />
                Geschichten
              </h2>
            </div>

            <div class="approach-content">
              <p class="approach-lead">
                Konflikte entstehen dort, wo unterschiedliche Bedürfnisse,
                Erwartungen und Perspektiven aufeinandertreffen.
              </p>

              <p>
                Als Mediatorin begleite ich die Beteiligten dabei, wieder miteinander
                ins Gespräch zu kommen, Interessen sichtbar zu machen und eigene,
                individuelle tragfähige Lösungen zu entwickeln.
              </p>
            </div>
          </div>
        </div>
      </section>
       <section class="contact" id="kontakt">
        <h2>Und oftmals beginnt eine Lösung<br />mit einem Gespräch.</h2>
        <p>
          Kontaktieren Sie mich gerne und wir klären, ob Mediation für Ihre
          Situation der passende Weg ist.
        </p>
        <div class="hero-actions">
          <a class="button button-consultation" href="/kontakt/#kontaktformular">
            Unverbindl. Erstgespräch
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#main-navigation");

  if (header && toggle && navigation) {
    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
      navigation.classList.toggle("is-open", open);
      header.classList.toggle("menu-open", open);
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) {
        setMenuOpen(false);
      }
    });

    window.matchMedia("(max-width: 900px)").addEventListener("change", () => {
      setMenuOpen(false);
    });

    header.classList.add("navigation-ready");
  }
</script>
<style>
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("/fonts/CormorantGaramond.ttf") format("truetype");
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #16343d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    min-height: 92px;
    padding: 18px 6% 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 184px;
    align-items: center;
    gap: 14px 24px;
    background: #f7f6f2;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }

  .brand {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    max-width: 480px;
    min-width: 0;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    background: linear-gradient(90deg, #173f5f, #168c91, #65a84b);
    -webkit-background-clip: text;
    color: transparent;
  }

  .brand-subtitle {
    margin-top: 2px;
    color: #65a84b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .main-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    min-width: 0;
    overflow-x: auto;
    gap: 18px;
    font-size: 1rem;
    text-align: right;
    padding: 24px max(6%, 54px);
  }

  .main-nav a {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 3px 18px;
    border: 1px solid rgba(22, 52, 61, .35);
    border-radius: 0;
    background: rgba(247, 250, 246, .94);
    box-shadow: 0 2px 7px rgba(22, 52, 61, .12);
    transition: background-color .2s ease, box-shadow .2s ease;
  }

  .main-nav a:hover {
    background: #fff;
    box-shadow: 0 3px 10px rgba(22, 52, 61, .2);
  }

  .menu-toggle {
    display: none;
    align-items: flex-end;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #126e73;
    font: inherit;
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: rgba(22, 140, 145, 0.08);
  }

  .menu-toggle:focus-visible,
  .main-nav a:focus-visible {
    outline: 2px solid #168c91;
    outline-offset: 4px;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 22px;
  }

  .menu-icon span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header-contact {
    padding: 11px 20px;
    border: 1px solid #168c91;
    border-radius: 999px;
    color: #126e73;
    font-size: 0.85rem;
  }
.hero {
  background: #eee3d1;
}

.hero-introduction {
  padding: 140px 8% 28px;
  background: #f7f6f2;
}

.hero-mediation {
  display: flow-root;
  padding: 0 8% 110px;
}

.hero-inner {
  max-width: 1180px;
  margin: 0 auto;
}

.hero-principles {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px 24px;
  text-align: center;
}

.hero-intro {
  margin: -1lh 0 12px;
  text-align: center;
  color: #168c91;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(2rem, 3.2vw, 2.65rem);
  font-weight: 400;
  line-height: 1.65;
}

.hero-photo {
  display: block;
  width: 100%;
  max-width: 960px;
  height: auto;
  margin: 32px auto 36px;
}

.eyebrow {
  margin: 0 0 24px;
  color: #168c91;
  font-size: 0.82rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.hero-principles {
  margin-bottom: clamp(48px, 5vw, 72px);
}

.conflict-consultation {
  margin-top: 64px;
}

.conflict-consultation h1 {
  max-width: 100%;
  margin: 0;
  text-align: center;
  color: #263438;
  font-size: clamp(2.3rem, 4vw, 4rem);
  line-height: 1.08;
  font-weight: 500;
  letter-spacing: -0.04em;
}

.hero-title {
  font-size: inherit;
  font-weight: 400;
}

.hero-resolution {
  font-size: inherit;
  letter-spacing: -0.025em;
}

@media (max-width: 800px) {
  .conflict-consultation h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  .hero-resolution,
  .conflict-location {
    font-size: clamp(1rem, 5vw, 5.4rem);
    white-space: nowrap;
  }
}

.mediation-columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: clamp(32px, 5vw, 64px);
  max-width: 1180px;
  margin: 8px auto 0;
}

.mediation-columns > * {
  min-width: 0;
  margin: 0;
}

@media (max-width: 800px) {
  .mediation-columns {
    grid-template-columns: minmax(0, 1fr);
  }
}

.hero-text {
  max-width: 760px;
  margin: 0;
  text-align: center;
  color: #566164;
  font-size: 1rem;
  line-height: 1.7;
}

.mediation-faq {
  margin-bottom: 28px;
}

.mediation-faq details + details {
  margin-top: 16px;
}

.mediation-faq summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  padding: 4px 0;
  color: #126e73;
  font-size: 1rem;
  line-height: 1.6;
  text-decoration: underline;
  text-underline-offset: 4px;
  list-style: none;
  cursor: pointer;
}

.mediation-faq summary::-webkit-details-marker {
  display: none;
}

.mediation-faq summary::after {
  content: "+";
  flex-shrink: 0;
  text-decoration: none;
}

.mediation-faq details[open] > summary::after {
  content: "−";
}

.mediation-faq summary:hover,
.faq-answer a:hover {
  color: #16343d;
}

.mediation-faq summary:focus-visible,
.faq-answer a:focus-visible {
  outline: 2px solid #126e73;
  outline-offset: 4px;
}

.faq-answer {
  padding: 4px 0 0;
  color: #566164;
  font-size: 1rem;
  line-height: 1.7;
}

.faq-answer p {
  margin: 12px 0 0;
}

.faq-answer a {
  color: #126e73;
  text-decoration: underline;
  text-underline-offset: 4px;
}

.law-source-link {
  font-size: 0.85rem;
}

.hero-text-highlight {
  color: #e00000;
}

@media (min-width: 801px) {
  .mediation-columns {
    position: relative;
    align-items: start;
    margin-top: calc(8px + 1lh);
  }

  .mediation-columns::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgba(22, 52, 61, 0.22);
  }

  .mediation-columns > .mediation-info {
    margin-top: calc(1.4rem * 1.8 + 4px);
  }
}

.mediation-benefits {
  text-align: left;
  color: #16343d;
  font-size: 1rem;
  line-height: 1.8;
}

.mediation-list {
  margin: 4px 0 0;
  padding-left: 1.25em;
  list-style-type: disc;
}

.mediation-closing {
  max-width: 1180px;
  margin: 6px auto 0;
  text-align: left;
  font-size: 1rem;
  line-height: 1.8;
}

@media (max-width: 800px) {
  .mediation-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-top: 8px;
  }

  .mediation-columns {
    display: contents;
  }

  .mediation-benefits {
    grid-row: 1;
  }

  .mediation-closing {
    grid-row: 2;
    min-width: 0;
    margin: -22px 0 28px;
  }

  .mediation-info {
    position: relative;
    grid-row: 3;
    padding-top: 28px;
  }

  .mediation-info::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(22, 52, 61, 0.22);
  }
}

.mediation-emphasis {
  color: #e00000;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 1.4em;
  font-weight: 700;
}

.hero-actions {
  display: flex;
  flex-wrap: nowrap;
  width: fit-content;
  max-width: 100%;
  overflow-x: auto;
  padding-block: 2px;
  gap: 14px;
  margin: 38px auto 0;
  text-align: center;
}

.hero-actions .button {
  flex-shrink: 0;
  border-radius: 999px;
  background: #168c91;
  color: #ffffff;
  white-space: nowrap;
}

.hero-actions .button-consultation {
  border-color: #e5b62f;
  background: #e5b62f;
  color: #16343d;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 24px;
  border: 1px solid #168c91;
  border-radius: 4px;
  color: #168c91;
  text-decoration: none;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.button.primary {
  background: #168c91;
  color: #ffffff;
}

.button:hover {
  transform: translateY(-1px);
}

.button.primary:hover {
  opacity: 0.88;
}
.trust-row {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 34px;
  color: #566164;
  font-size: 0.9rem;
}

.trust-row span {
  display: flex;
  align-items: center;
  gap: 9px;
}

.trust-row span::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #78b82a;
}
.satisfaction-statement {
  margin: 36px 0 24px;
