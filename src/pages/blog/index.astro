---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { posts } from "../../data/blog";
---

<BlogLayout
  title="Blog"
  description="Gedanken und Impulse zu Konflikten, Verständigung und gemeinsamen Lösungen – im privaten Umfeld und im Unternehmen."
>
  <div class="posts">
    {posts.map((post) => (
      <article>
        <p class="category">{post.category}</p>
        <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
        <p class="summary">{post.summary}</p>
        <a class="read-more" href={`/blog/${post.slug}/`} aria-label={`Beitrag lesen: ${post.title}`}>
          Beitrag lesen →
        </a>
      </article>
    ))}
  </div>
</BlogLayout>

<style>
  .posts { max-width: 800px; margin: 0 auto; }
  article { padding: 32px 0; border-top: 1px solid #d8dfdc; }
  .category { margin: 0 0 12px; color: #168c91; font-size: 0.9rem; }
  h2 { margin: 0 0 16px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 400; line-height: 1.3; }
  h2 a { text-decoration: none; }
  h2 a:hover { color: #168c91; }
  .summary { margin: 0 0 20px; color: #566164; }
  .read-more { color: #168c91; text-underline-offset: 4px; }
</style>
