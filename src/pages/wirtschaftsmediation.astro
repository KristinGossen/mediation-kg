---
import SiteFooter from "../components/SiteFooter.astro";
import Illustration from "../components/Illustration.astro";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Wirtschaftsmediation für Konflikte zwischen Mitarbeitenden, Teams und Führungskräften – professionell, strukturiert und auf Wunsch dokumentiert." />
    <title>Wirtschaftsmediation | Kristin Goßen</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="back-link" href="/#wirtschaftsmediation">← Zur Startseite</a>
    </header>
    <main>
      <h1>Wirtschaftsmediation</h1>
      <Illustration
        class="team-image"
        src="/motiviertes-team.png"
        alt="KI-generierte Illustration eines motivierten Teams, das in einem hellen Büro zusammenarbeitet."
        width={1536}
        height={1024}
        fetchpriority="high"
      />
      <div class="description">
        <h2>Wenn Zusammenarbeit wieder möglich werden soll.</h2>
        <p>
          Für Konflikte zwischen Mitarbeitenden, Teams oder Führungskräften –
          professionell, strukturiert und auf Wunsch dokumentiert.
        </p>
        <a class="consultation" href="tel:+4915161235537">Unverbindliches Erstgespräch</a>
        <p class="satisfaction-text">
          Zufriedenheit ist ein Verdienst<br />
          - ein unabdingliches Leistungspotenzial.<br />
          Sie setzt enorme Energien und Motivationen frei, die künstlich kaum erzeugt werden können<br />
          - sie ist der Treibstoff für Hochleistung.
        </p>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #16343d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 18px 6%;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }

  .brand {
    width: min(340px, 100%);
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.78) contrast(1.3) saturate(1.1);
  }

  .back-link {
    color: #168c91;
  }

  main {
    max-width: 1376px;
    margin: 0 auto;
    padding: 40px 24px 72px;
  }

  h1 {
    margin: 0 0 30px;
    text-align: center;
    font-size: clamp(1.6rem, 5vw, 3.5rem);
    font-weight: 500;
  }

  .team-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .description {
    max-width: 760px;
    margin: 40px auto 0;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
    font-weight: 500;
  }

  .consultation {
    display: inline-block;
    margin-top: 16px;
    padding: 14px 24px;
    border: 1px solid #e5b62f;
    border-radius: 999px;
    background: #e5b62f;
  }

  .satisfaction-text {
    margin: 30px 0 0;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.6;
  }

</style>
