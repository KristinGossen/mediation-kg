---
import SiteFooter from "../components/SiteFooter.astro";
import ContactStrip from "../components/ContactStrip.astro";
import Illustration from "../components/Illustration.astro";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Wirtschaftsmediation für Konflikte zwischen Mitarbeitenden, Teams und Führungskräften – professionell, strukturiert und auf Wunsch dokumentiert." />
    <title>Wirtschaftsmediation | Kristin Goßen</title>
  </head>
  <body>
    <ContactStrip />
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="back-link" href="/">← Zur Startseite</a>
    </header>
    <main>
      <div class="business-introduction">
      <div class="business-content">
      <h1>Wirtschaftsmediation</h1>
      <Illustration
        class="team-image"
        src="/motiviertes-team.png"
        alt="KI-generierte Illustration eines motivierten Teams, das in einem hellen Büro zusammenarbeitet."
        width={1536}
        height={1024}
        fetchpriority="high"
      />
      <div class="description">
        <h2>Wenn Zusammenarbeit wieder möglich werden soll.</h2>
        <p>
          Für Konflikte zwischen Mitarbeitenden, Teams oder Führungskräften –
          professionell, strukturiert und auf Wunsch dokumentiert.
        </p>
      </div>
      </div>
      </div>
      <div class="satisfaction-section">
        <p class="satisfaction-text">
          <span class="satisfaction-highlight">Zufriedenheit ist ein Verdienst</span>
          - ein unabdingliches Leistungspotenzial.<br />
          - sie setzt enorme Energien und Motivationen frei,<br />die künstlich kaum erzeugt werden können
          <span class="satisfaction-highlight">- sie ist der Treibstoff für Hochleistung.</span>
        </p>
      </div>
      <div class="business-process">
      <div class="business-content">
      <div class="mediation-stages">
        <section class="mediation-stage" aria-labelledby="understanding-heading">
          <h2 id="understanding-heading">Wie sieht die Verständigung aus?</h2>
          <ul>
            <li>Rahmenbedingungen klären</li>
            <li>Interessen und Optionen</li>
            <li>Mediationsvereinbarung</li>
            <li>verfügbare Ressourcen ermitteln</li>
          </ul>
        </section>
        <section class="mediation-stage" aria-labelledby="success-heading">
          <h2 id="success-heading">Wie kommen wir zum entscheidenden Erfolg?</h2>
          <ul>
            <li>Individuelle Dialoge</li>
            <li>Bedürfnisse äußern</li>
            <li>Konfliktthemen priorisieren</li>
            <li>Entwickeln von Lösungsideen</li>
            <li>Zielorientierte Maßnahmen festlegen</li>
          </ul>
        </section>
        <section class="mediation-stage" aria-labelledby="conclusion-heading">
          <h2 id="conclusion-heading">Welches Fazit resultiert aus der Mediation?</h2>
          <ul>
            <li>Ansprüche erfasst</li>
            <li>Prekäre Situation erkannt</li>
            <li>Effektive gemeinsame Lösungen</li>
            <li>Reflektierte Selbstwahrnehmung</li>
            <li>Zielorientierte Maßnahmen umsetzen</li>
          </ul>
        </section>
        <section class="mediation-stage mediation-process" aria-labelledby="process-heading">
          <h2 id="process-heading">Wie läuft Mediation ab?</h2>
          <p class="process-principles">Nach den 5 Phasen der Mediation:</p>
          <ol class="mediation-phases">
            <li>
              1. Rahmenbedingungen, Ablauf und Regeln werden erläutert und die
              Schweigepflicht nach außen wird erklärt.
            </li>
            <li>
              2. Ansichten, Konflikte und Problematiken äußern. Der/die Mediator-in ist
              parteilos und neutral und gibt jedem genügend Raum, seine eigene
              Sichtweise darzustellen.
            </li>
            <li>
              3. Aufdecken der Hintergründe: Interessen, Motive, Gefühle,
              Bedürfnisse und Wünsche werden herausgearbeitet, um Ursachen von
              Konflikten zu erkennen und auch Missverständnisse auszuräumen.
            </li>
            <li>4. Lösungsvorschläge und Lösungsentwicklung</li>
            <li>5. Lösungsvereinbarung</li>
          </ol>
        </section>
      </div>
      <div class="closing-contact">
        <a class="consultation" href="/kontakt/#kontaktformular">Unverbindliches Erstgespräch</a>
      </div>
      </div>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #eee3d1;
    color: #16343d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  header {
    background: #f7f6f2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 18px 6%;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }

  .brand {
    width: min(340px, 100%);
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.78) contrast(1.3) saturate(1.1);
  }

  .back-link {
    color: #168c91;
  }

  .business-content {
    max-width: 1328px;
    margin: 0 auto;
  }

  .business-introduction {
    display: flow-root;
    padding: 40px 24px 28px;
  }

  .business-introduction .description > p:last-child {
    margin-bottom: 0;
  }

  .satisfaction-section {
    padding: 32px 24px 28px;
    background: #f7f6f2;
  }

  .business-process {
    padding: 28px 24px 72px;
  }

  h1 {
    margin: 0 0 30px;
    text-align: center;
    font-size: clamp(1.6rem, 5vw, 3.5rem);
    font-weight: 500;
  }

  .team-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .description {
    max-width: 760px;
    margin: 40px auto 0;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.25;
    font-weight: 500;
  }

  .consultation {
    display: inline-block;
    margin-top: 16px;
    padding: 14px 24px;
    border: 1px solid #e5b62f;
    border-radius: 999px;
    background: #e5b62f;
  }

  .closing-contact {
    margin-top: 24px;
    text-align: center;
  }

  .satisfaction-text {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .satisfaction-highlight {
    display: block;
    color: #b32626;
    font-weight: 700;
  }

  .satisfaction-highlight:first-child {
    margin-bottom: 12px;
  }

  .satisfaction-highlight:last-child {
    margin-top: 12px;
  }

  .mediation-stages {
    max-width: 760px;
    margin: 0 auto;
  }

  .mediation-stage {
    padding: 28px 0;
    border-top: 1px solid #dce7e5;
  }

  .mediation-stage h2 {
    margin: 0 0 16px;
  }

  .mediation-stage ul {
    margin: 0;
    padding-left: 1.25em;
  }

  .mediation-stage li + li {
    margin-top: 8px;
  }

  .process-principles {
    margin: 24px 0 0;
  }

  .mediation-phases {
    color: #168c91;
    display: grid;
    gap: 1lh;
    margin: 1lh 0 0;
    padding: 0;
    list-style: none;
  }

  .mediation-phases li + li {
    margin-top: 0;
  }

</style>
