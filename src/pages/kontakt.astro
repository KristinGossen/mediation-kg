---
import SiteFooter from "../components/SiteFooter.astro";
import ContactStrip from "../components/ContactStrip.astro";
import ContactForm from "../components/ContactForm.astro";
import { contact } from "../data/contact";
const showContactForm = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === "true";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Kontakt zu Kristin Goßen: Rufen Sie an und besprechen Sie Ihre Anliegen in einem unverbindlichen Erstgespräch." />
    <title>Kontakt | Mediation Kristin Goßen</title>
  </head>
  <body>
    <ContactStrip />
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="back-link" href="/">← Zur Startseite</a>
    </header>
    <main>
      <div class="contact-introduction">
      <h1>Und oftmals beginnt eine Lösung<br />mit einem Gespräch.</h1>
      <p>
        In einem unverbindlichen Erstgespräch klären wir gemeinsam,
        ob Mediation für Ihre Situation der passende Weg ist.
      </p>
      </div>
      {showContactForm && <ContactForm />}
      <div class="contact-section">
      <div class="contact-content">
      <div class="contact-grid">
        <address aria-label="Mediation KG – Anschrift und Telefon">
          <img class="contact-logo" src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" width="2079" height="756" />
          <p class="business-address">Kohlenstrasse 25<br />42555 Velbert</p>
          <p class="phone-contact">Telefon: <a href={contact.phoneHref}>{contact.phone}</a></p>
          <p class="email-contact">E-Mail: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </address>
        <section class="meeting-options" aria-label="Gesprächsmöglichkeiten">
          <h3>Online oder vor Ort</h3>
          <p>
            in unseren Besprechungsräumen.<br />
            Für Unternehmen in unseren
            Seminarräumen oder direkt in Ihren eigenen Räumlichkeiten.
          </p>
        </section>
      </div>
      </div>
      </div>
      <div class="closing-section">
        <p class="closing">Ich nehme mir Zeit für Ihre Anliegen und freue mich auf Ihre Kontaktaufnahme.</p>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("/fonts/CormorantGaramond.ttf") format("truetype");
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
  }

  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #eee3d1;
    color: #16343d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  :global(a) { color: inherit; text-decoration: none; }
  header {
    background: #f7f6f2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 18px 6%;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }
  .brand { width: min(340px, 100%); }
  .brand img, .contact-logo {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.78) contrast(1.3) saturate(1.1);
  }
  .back-link { color: #168c91; }
  main { text-align: center; }
  .contact-introduction { max-width: 1008px; margin: 0 auto; padding: 40px 24px 0; }
  .contact-section { margin-top: 40px; padding: 0 24px 28px; background: #f7f6f2; }
  .contact-content { max-width: 960px; margin: 0 auto; }
  .contact-introduction h1 { margin: 0 0 24px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 400; line-height: 1.3; }
  .contact-introduction > p, .closing { max-width: 720px; margin: 0 auto 24px; font-size: 1.1rem; }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: last baseline;
    margin-top: 0;
    padding-top: 36px;
    border-top: 1px solid #d8dfdc;
  }
  address { margin: 0; font-style: normal; text-align: left; }
  .contact-logo { width: min(220px, 100%); margin: 0 0 8px; }
  .business-address {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
  }
  .phone-contact { margin: 28px 0 0; }
  .email-contact { margin: 28px 0 0; overflow-wrap: anywhere; }
  .phone-contact a, .email-contact a { color: #126e73; text-decoration: underline; text-underline-offset: 3px; }
  .meeting-options { text-align: left; }
  .meeting-options h3 {
    margin: 0;
    color: #168c91;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .meeting-options p { margin: 0; }
  .closing-section { padding: 40px 24px 60px; background: #eee3d1; }
  .closing { margin: 0 auto; }
  :global(a:focus-visible) { outline: 2px solid #168c91; outline-offset: 5px; }
  @media (max-width: 700px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); align-items: center; }
    address { text-align: center; }
    .contact-logo { margin: 0 auto 8px; }
    .meeting-options { text-align: center; padding-top: 28px; border-top: 1px solid #d8dfdc; }
  }
</style>
