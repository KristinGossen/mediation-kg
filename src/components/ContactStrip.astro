---
import { contact } from "../data/contact";
---

<aside class="contact-strip" aria-label="Kontakt und Anschrift">
  <div class="identity">
    <a class="home-link" href="/" aria-label="Mediation Kristin Goßen – Startseite">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" /></svg>
      <span>Mediation · {contact.name}</span>
    </a>
    <span class="address-part">{contact.street}</span>
    <span class="address-part">{contact.city}</span>
  </div>
  <div class="contact-links">
    <a href={contact.phoneHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-3 2a16 16 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 5a2 2 0 0 1 2-2Z" /></svg>
      <span>{contact.phone}</span>
    </a>
    <a class="email-link" href={`mailto:${contact.email}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 6 9 7 9-7" /></svg>
      <span>{contact.email}</span>
    </a>
  </div>
</aside>

<style>
  .contact-strip {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 24px;
    min-height: 36px;
    padding: 7px 6%;
    background: #fff;
    color: #16343d;
    border-bottom: 1px solid rgba(22, 52, 61, 0.12);
    box-shadow: 0 2px 5px rgba(22, 52, 61, 0.08);
    font: 400 13px/1.5 Arial, Helvetica, sans-serif;
  }

  .identity,
  .contact-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    color: #126e73;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:focus-visible {
    outline: 2px solid #168c91;
    outline-offset: 3px;
  }

  svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .address-part,
  .email-link {
    padding-left: 12px;
    border-left: 1px solid rgba(22, 52, 61, 0.35);
  }

  .address-part {
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .contact-strip {
      justify-content: center;
    }
  }

  @media (max-width: 900px) {
    .contact-strip {
      display: none;
    }
  }
</style>
