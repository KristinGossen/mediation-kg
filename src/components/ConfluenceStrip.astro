---
import { getImage } from "astro:assets";
import pattern from "../assets/fischgraet-zusammenfluss.png";
const image = await getImage({ src: pattern, width: 1800, format: "webp", quality: 82 });
---

<div class="confluence-strip" style={`--confluence-image: url("${image.src}")`}>
  <div class="confluence-art" aria-hidden="true">
    <span class="flow-half flow-left"></span>
    <span class="flow-half flow-right"></span>
    <span class="meeting-light"></span>
  </div>
  <slot />
  <button class="motion-toggle" type="button" aria-label="Animation anhalten" aria-pressed="false" hidden>
    <svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 5v10M14 5v10" /></svg>
    <svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".confluence-strip").forEach((strip) => {
    const toggle = strip.querySelector<HTMLButtonElement>(".motion-toggle");
    if (!toggle) return;
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const paused = strip.classList.toggle("is-paused");
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.setAttribute("aria-label", paused ? "Animation fortsetzen" : "Animation anhalten");
    });
  });
</script>

<style>
  .confluence-strip {
    position: relative;
    isolation: isolate;
    grid-column: 1 / -1;
    grid-row: 2;
    margin-inline: -6.818182%;
    background: #568b8d;
  }
  .confluence-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--confluence-image) center / 100% auto no-repeat;
  }
  .flow-half {
    position: absolute;
    inset-block: 0;
    width: 50%;
    overflow: hidden;
  }
  .flow-left { left: 0; }
  .flow-right { right: 0; }
  .flow-half::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--confluence-image);
    background-size: 200% auto;
    background-repeat: no-repeat;
    animation: merge-left 7s ease-in-out infinite;
    mask-image: linear-gradient(90deg, transparent, #000 20%, #000 72%, transparent);
  }
  .flow-left::before { background-position: left center; }
  .flow-right::before {
    background-position: right center;
    animation-name: merge-right;
  }
  .flow-half::after {
    content: "";
    position: absolute;
    inset-block: 0;
    left: -38%;
    width: 38%;
    background: linear-gradient(90deg, transparent, rgba(210, 252, 235, .55), transparent);
    mix-blend-mode: screen;
    animation: converge-left 7s ease-in-out infinite;
  }
  .flow-right::after {
    left: auto;
    right: -38%;
    animation-name: converge-right;
  }
  .meeting-light {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 15%, rgba(203, 240, 228, .12) 32%, rgba(226, 255, 242, .55) 50%, rgba(203, 240, 228, .12) 68%, transparent 85%);
    animation: meeting-glow 7s ease-in-out infinite;
  }
  .motion-toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 7px;
    color: #16343d;
    background: rgba(247, 250, 246, .92);
    border: 1px solid rgba(22, 52, 61, .2);
    border-radius: 50%;
    cursor: pointer;
  }
  .motion-toggle[hidden] { display: none; }
  .motion-toggle svg { width: 100%; height: 100%; stroke: currentColor; stroke-width: 2; fill: none; }
  .motion-toggle .play-icon { display: none; fill: currentColor; stroke: none; }
  .is-paused .pause-icon { display: none; }
  .is-paused .play-icon { display: block; }
  .motion-toggle:focus-visible { outline: 2px solid #16343d; outline-offset: 3px; }
  .is-paused .flow-half::before, .is-paused .flow-half::after, .is-paused .meeting-light { animation-play-state: paused; }
  @keyframes merge-left {
    0% { transform: translateX(-28px); opacity: 0; }
    30% { opacity: .55; }
    75%, 100% { transform: translateX(0); opacity: 0; }
  }
  @keyframes merge-right {
    0% { transform: translateX(28px); opacity: 0; }
    30% { opacity: .55; }
    75%, 100% { transform: translateX(0); opacity: 0; }
  }
  @keyframes meeting-glow {
    0%, 100% { opacity: .4; }
    70% { opacity: 1; }
  }
  @keyframes converge-left {
    0% { transform: translateX(0); opacity: 0; }
    18% { opacity: .65; }
    70% { transform: translateX(360%); opacity: .85; }
    85%, 100% { transform: translateX(360%); opacity: 0; }
  }
  @keyframes converge-right {
    0% { transform: translateX(0); opacity: 0; }
    18% { opacity: .65; }
    70% { transform: translateX(-360%); opacity: .85; }
    85%, 100% { transform: translateX(-360%); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-half::before, .flow-half::after, .meeting-light { animation: none; }
    .flow-half::before, .flow-half::after { opacity: 0; }
    .meeting-light { opacity: .7; }
    .motion-toggle { display: none; }
  }
</style>
