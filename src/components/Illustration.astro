---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, class: className, width, height, loading, fetchpriority, ...rest } = Astro.props;
---

<figure class={className} {...rest} data-ai-illustration>
  <img {src} {alt} {width} {height} {loading} {fetchpriority} decoding="async" />
  <figcaption aria-label="KI-generiert">AI</figcaption>
</figure>

<style>
  figure {
    position: relative;
    display: block;
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  figcaption {
    position: absolute;
    bottom: 7px;
    left: 7px;
    margin: 0;
    color: rgba(52, 67, 70, 0.55);
    font: 400 9px/1.2 Arial, Helvetica, sans-serif;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
</style>
