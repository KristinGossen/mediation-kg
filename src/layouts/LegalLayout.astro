---
import SiteFooter from "../components/SiteFooter.astro";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Mediation Kristin Goßen</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" width="2079" height="756" />
      </a>
      <a class="back-link" href="/">← Zur Startseite</a>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("/fonts/CormorantGaramond.ttf") format("truetype");
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
  }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f7f6f2; color: #16343d; font-family: Arial, Helvetica, sans-serif; line-height: 1.7; }
  header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; padding: 18px 6%; border-bottom: 1px solid rgba(22, 52, 61, 0.1); }
  .brand { width: min(340px, 100%); }
  .brand img { display: block; width: 100%; height: auto; filter: brightness(0.78) contrast(1.3) saturate(1.1); }
  .back-link { color: #126e73; text-decoration: none; }
  main { max-width: 840px; margin: 0 auto; padding: 48px 24px 72px; overflow-wrap: anywhere; }
  h1 { margin: 0 0 36px; color: #168c91; font-family: "Cormorant Garamond", "Times New Roman", serif; font-size: clamp(2.5rem, 7vw, 3.8rem); font-weight: 400; line-height: 1.2; }
  main :global(h2) { margin: 36px 0 12px; font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; font-weight: 400; line-height: 1.4; }
  main :global(p) { margin: 0 0 18px; }
  main :global(address) { font-style: normal; }
  main :global(a) { color: #126e73; text-underline-offset: 3px; }
  main :global(li) { margin-bottom: 8px; }
  main :global(ul) { padding-left: 24px; }
  :global(a:focus-visible) { outline: 2px solid #168c91; outline-offset: 4px; }
  @media (max-width: 600px) { main { padding: 32px 20px 48px; } }
</style>
