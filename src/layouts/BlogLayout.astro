---
interface Props {
  title: string;
  description: string;
  category?: string;
}
const { title, description, category } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Mediation Kristin Goßen</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Mediation Kristin Goßen – Startseite">
        <img src="/mediation-logo.png" alt="Mediation KG – Faire Konfliktlösung" />
      </a>
      <a class="back-link" href="/">← Zur Startseite</a>
    </header>
    <main>
      <div class="page-heading">
        {category && <a class="back-link" href="/blog/">← Alle Beiträge</a>}
        {category && <p class="category">{category}</p>}
        <h1>{title}</h1>
        <p class="intro">{description}</p>
      </div>
      <div class="blog-content"><slot /></div>
      <section class="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Ein Gespräch kann der Anfang sein.</h2>
        <p>Wir nehmen uns Zeit für Ihre Anliegen.</p>
        <a class="consultation" href="tel:+4915161235537">Unverbindliches Erstgespräch</a>
      </section>
    </main>
    <footer>
      <p>© 2026 MEDIATION KG · Faire Konfliktlösung</p>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: "Allura";
    src: url("/fonts/Allura-Regular.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #16343d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
  }
  :global(a) { color: inherit; }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 18px 6%;
    line-height: 1.6;
    border-bottom: 1px solid rgba(22, 52, 61, 0.1);
  }
  .brand { width: min(340px, 100%); }
  .brand img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.78) contrast(1.3) saturate(1.1);
  }
  main { max-width: 1008px; margin: 0 auto; padding: 48px 24px 72px; }
  .page-heading { text-align: center; margin-bottom: 52px; }
  .back-link { color: #168c91; text-decoration: none; }
  .category { margin: 32px 0 0; color: #168c91; }
  h1 {
    margin: 28px auto 20px;
    color: #168c91;
    font-family: "Allura", cursive;
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: break-word;
  }
  .intro { max-width: 720px; margin: 0 auto; color: #566164; font-size: 1.1rem; }
  .blog-content :global(.article-body) { max-width: 720px; margin: 0 auto; }
  .blog-content :global(.article-body h2) {
    margin: 36px 0 16px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 400;
    line-height: 1.3;
  }
  .blog-content :global(.article-body p) { margin: 0 0 20px; }
  .contact { margin-top: 64px; padding-top: 36px; border-top: 1px solid #d8dfdc; text-align: center; }
  .contact h2 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; line-height: 1.3; }
  .consultation {
    display: inline-block;
    margin-top: 12px;
    padding: 14px 24px;
    border: 1px solid #e5b62f;
    border-radius: 999px;
    background: #e5b62f;
    text-decoration: none;
  }
  :global(a:focus-visible) { outline: 2px solid #168c91; outline-offset: 5px; }
  footer { padding: 24px; border-top: 1px solid #d8dfdc; text-align: center; font-size: 0.9rem; }
  footer a { color: #168c91; }
  @media (max-width: 600px) {
    main { padding: 32px 20px 48px; }
  }
</style>
